{
  "name": "dsh-inspirations",
  "version": "0.6.0",
  "description": "灵感便签：DSH 左侧栏里的一面满幅便签墙，手写字体、6 色便签与叠纸编辑，可复制、可和 AI 讨论。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar-panel",
    "sticky-notes",
    "inspiration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaquchi/dsh-inspirations.git"
  },
  "homepage": "https://github.com/chaquchi/dsh-inspirations",
  "bugs": {
    "url": "https://github.com/chaquchi/dsh-inspirations/issues"
  },
  "author": "biao"
}
